# ╔══════════════════════════════════════════════════════════════╗
# ║  SentiVox — Environment Configuration                      ║
# ║  Copy this file to .env and customize for your environment  ║
# ╚══════════════════════════════════════════════════════════════╝

# ─── Environment ──────────────────────────────────────────────
# Options: development, production
SENTIVOX_ENV=development

# ─── Security (REQUIRED in production) ────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
# JWT_SECRET_KEY=your-super-secret-key-here

# ─── Database ─────────────────────────────────────────────────
# Default: sqlite:///sentivox.db
# PostgreSQL: postgresql://user:pass@localhost:5432/sentivox
# DATABASE_URL=sqlite:///sentivox.db

# ─── Server ───────────────────────────────────────────────────
# HOST=127.0.0.1
# PORT=8000
# WORKERS=1

# ─── CORS Origins (REQUIRED in production) ────────────────────
# Comma-separated list of allowed origins
# CORS_ORIGINS=https://yourdomain.com,https://app.yourdomain.com

# ─── JWT Token Expiry ─────────────────────────────────────────
# ACCESS_TOKEN_EXPIRE_MINUTES=30
# REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── Audio Processing ────────────────────────────────────────
# MAX_FILE_SIZE_MB=15
# MAX_BATCH_FILES=20
# SAMPLE_RATE_HZ=16000
# SILENCE_TRIM_DB=25

# ─── Default Admin Account (first boot seed) ──────────────────
# DEFAULT_ADMIN_EMAIL=admin@sentivox.com
# DEFAULT_ADMIN_PASSWORD=change-me-immediately
# DEFAULT_ADMIN_NAME=System Administrator

# ─── Rate Limiting ────────────────────────────────────────────
# RATE_LIMIT_AUTH=10/minute
# RATE_LIMIT_PREDICT=30/minute

# ─── Logging ──────────────────────────────────────────────────
# LOG_LEVEL=INFO
# LOG_FORMAT=json
