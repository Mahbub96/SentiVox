# ╔══════════════════════════════════════════════════════════════╗
# ║  SentiVox — Production Environment (144.24.142.3)          ║
# ║  JWT_SECRET_KEY is auto-generated on first deploy          ║
# ╚══════════════════════════════════════════════════════════════╝

# ─── Environment ──────────────────────────────────────────────
SENTIVOX_ENV=production

# ─── Security ─────────────────────────────────────────────────
# This will be auto-generated by deploy.sh on first run
JWT_SECRET_KEY=REPLACE_ME_ON_FIRST_DEPLOY

# ─── Database ─────────────────────────────────────────────────
DATABASE_URL=sqlite:///sentivox.db

# ─── Server ───────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
WORKERS=1

# ─── CORS Origins (mobile app + direct IP access) ────────────
CORS_ORIGINS=http://144.24.142.3,http://144.24.142.3:8000,http://144.24.142.3:80

# ─── JWT Token Expiry ─────────────────────────────────────────
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ─── Audio Processing ────────────────────────────────────────
MAX_FILE_SIZE_MB=15
MAX_BATCH_FILES=20

# ─── Default Admin Account ────────────────────────────────────
DEFAULT_ADMIN_EMAIL=admin@sentivox.com
DEFAULT_ADMIN_PASSWORD=SentiVox@Admin2026!
DEFAULT_ADMIN_NAME=System Administrator

# ─── Rate Limiting ────────────────────────────────────────────
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_PREDICT=30/minute

# ─── Logging ──────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json
